{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Polaris",
  "version": "1.3.0",
  "identifier": "com.polaris.vsuifinder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Polaris",
        "width": 1280,
        "height": 800,
        "minWidth": 519,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2RDI2MEQ0NTRGNTY1RUUKUldUdVpmVlUxR0RTTmhUVDB5RGhTalNtMW1tOUxOc3A3ZkJ1S3dBUThzaGlVYTdFU28zLzNzN1gK",
      "endpoints": ["https://github.com/noma-t/Polaris/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
